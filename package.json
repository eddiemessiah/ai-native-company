{
  "name": "ai-native-company",
  "private": true,
  "description": "Monorepo for an AI-native firm: decision brain, catalog, website, agent-payable APIs, company OS.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test",
    "worktree": "bash scripts/worktree.sh"
  }
}
