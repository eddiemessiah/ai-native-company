# Public URL of the site. Set it at BUILD time for a custom domain: static routes (llms.txt,
# agent card, sitemap, OG tags) bake it in. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Decision brain providers, tried in this order. The public demo falls back to a free
# lexical heuristic; the paid /api/v1 routes never do (no real provider -> 503, no charge).
TYPESAFE_API_KEY=            # Jev direct (TypeSafe System One). Early access is waitlisted.
JEV_MODEL=jev-1.13.0         # Pin the version; jev-latest moves when a release ships.
AI_GATEWAY_API_KEY=          # Jev via Vercel AI Gateway (typesafe-ai/jev-latest). On Vercel, OIDC works too.
OPENROUTER_API_KEY=          # Jev via OpenRouter (~typesafe/jev-latest)
ANTHROPIC_API_KEY=           # Claude fallback for decisions (uncalibrated: gates add +0.1)
BRAIN_FALLBACK_MODEL=claude-opus-5

# GTM Harness (/gtm and `pnpm gtm`): any model writes the plan; with none, templates do.
#   Claude:            ANTHROPIC_API_KEY (GTM_MODEL defaults to claude-opus-5)
#   Any provider:      GTM_MODEL=openai/gpt-5 (provider/model) + AI_GATEWAY_API_KEY (or OIDC on Vercel), or OPENROUTER_API_KEY
#   Any endpoint:      GTM_BASE_URL (xAI, Ollama, LM Studio…) + GTM_MODEL + GTM_API_KEY
GTM_MODEL=                   # optional; a bare id goes to Anthropic, provider/model to a router
GTM_BASE_URL=                # optional: an OpenAI-compatible /chat/completions endpoint
GTM_API_KEY=                 # optional: its key
GTM_EFFORT=low               # low | medium | high: higher reads better and runs slower (Claude)
GTM_RUNS_PER_HOUR=6          # per IP; raise it for a live demo where the room shares one network
GTM_SLACK_WEBHOOK_URL=       # optional (CLI): review copies of drafts in Slack
GTM_APPROVER_IDS=            # optional (CLI): Telegram user ids allowed to approve drafts (TELEGRAM_* below)

# Shonin GTM private beta (/beta, /api/beta/*). On Vercel (production or preview) the routes answer
# 503 until the three keys and Upstash are set; locally they use dev keys and a memory store.
# Make a key with: openssl rand -hex 32
BETA_GATE=open               # open | invite
BETA_INVITE_CODES=           # comma-separated, used when BETA_GATE=invite
BETA_SESSION_SECRET=         # 32 random bytes, hex: signs the session cookie
BETA_SIGNING_KEY=            # 32 random bytes, hex: signs approvals and receipts
BETA_ENCRYPTION_KEY=         # 32 random bytes, hex: encrypts connector tokens
BETA_SITE_URL=               # optional: the beta's origin if it differs from NEXT_PUBLIC_SITE_URL (POSTs must come from it)
BETA_RUNS=                   # off = kill switch: nothing posts on approval; every action becomes a link
BETA_ADMIN_TOKEN=            # Bearer token for POST /api/beta/telegram/setup (registers the bot's webhook)
KV_REST_API_URL=             # Upstash Redis REST (Vercel Marketplace sets these)
KV_REST_API_TOKEN=
TELEGRAM_BETA_BOT_TOKEN=     # the beta's own bot (not TELEGRAM_BOT_TOKEN, which is lead alerts)
TELEGRAM_BETA_BOT_USERNAME=
TELEGRAM_BETA_WEBHOOK_SECRET= # any long random string; Telegram sends it back on every update
X_CLIENT_ID=                 # an X app with OAuth 2.0; callback <site>/api/beta/x/callback
X_CLIENT_SECRET=

# Lead alerts: every intake and study application lands on your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEADS_WEBHOOK_URL=           # optional: Slack/Zapier/n8n/Sheets webhook

# People pay through Stripe Checkout: cards, wallets and bank debits, shown in the buyer's currency.
# Needs a Stripe account; from Nigeria, Stripe Atlas (a US company) is the usual route.
STRIPE_SECRET_KEY=           # sk_live_… (offer pages show "Pay and start" only when this is set at build time)
STRIPE_WEBHOOK_SECRET=       # whsec_… for /api/stripe/webhook (event: checkout.session.completed)

# Links shown after intake
NEXT_PUBLIC_BOOKING_URL=     # e.g. https://cal.com/<you>/intro
NEXT_PUBLIC_STRIPE_URL=      # optional Stripe payment link for custom amounts
NEXT_PUBLIC_PAYSTACK_URL=    # optional local rails in Africa (NGN, GHS, KES, ZAR)

# x402 v2: agents pay per call in USDC on Celo. Paid routes answer 503 until X402_PAY_TO is set.
X402_PAY_TO=                 # receiving wallet (0x + 40 hex). Use a fresh wallet, not a personal one.
X402_NETWORK=celo            # celo (eip155:42220) or celo-sepolia (eip155:11142220)
X402_API_KEY=                # from x402.celo.org; the hosted facilitator needs it to settle
X402_FACILITATOR_URL=        # optional override; defaults to Celo's hosted facilitator for the network
CDP_API_KEY_ID=              # optional: adds Base (USDC) through Coinbase's facilitator and lists us in the x402 Bazaar
CDP_API_KEY_SECRET=

# Shonin Receipt
RECEIPT_SIGNING_KEY=         # optional 0x… private key that signs receipts (use a dedicated key that holds no funds)
RPC_URL_42220=               # optional RPC overrides per chain id; defaults to public endpoints (Celo shown)

# ERC-8004 identity served at /agent.json (registration-v1)
ERC8004_AGENT_ID=

# Video Desk and Explainer Shorts (pnpm video; runs on your machine, not on the site).
# Reuse this file with: set -a; source apps/web/.env.local; set +a
AZURE_SPEECH_KEY=            # shorts voice for published work: Azure's en-NG neural voices
AZURE_SPEECH_REGION=         # e.g. westeurope
LOCAL_TTS_URL=               # optional: your own OpenAI-compatible speech server, e.g. http://127.0.0.1:8880/v1 (scripts/kokoro_server.py)
LOCAL_TTS_MODEL=             # the engine id: kokoro (default), or voxcpm2 on VoiceStudio. Its licence comes from the allowlist in code
LOCAL_TTS_VOICE=             # e.g. af_heart; a cloned voice needs a release (pnpm video voice)
LOCAL_TTS_KEY=               # optional: sent as a Bearer token (VoiceStudio's OMNIVOICE_API_KEY)
OPENAI_API_KEY=              # optional: OpenAI voices
ELEVENLABS_API_KEY=          # optional: ElevenLabs voices
ELEVENLABS_PLAN=             # your paid plan (creator, pro…); the Free plan has no commercial licence
PEXELS_API_KEY=              # optional: stock footage for --visuals stock
