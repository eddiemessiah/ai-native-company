# Public URL of the site. Set it at BUILD time for a custom domain: static routes (llms.txt,
# agent card, sitemap, OG tags) bake it in. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Decision brain providers, tried in this order. The public demo falls back to a free
# lexical heuristic; the paid /api/v1 routes never do (no real provider -> 503, no charge).
TYPESAFE_API_KEY=            # Jev direct (TypeSafe System One). Early access is waitlisted.
JEV_MODEL=jev-1.13.0         # Pin the version; jev-latest moves when a release ships.
AI_GATEWAY_API_KEY=          # Jev via Vercel AI Gateway (typesafe-ai/jev-latest). On Vercel, OIDC works too.
OPENROUTER_API_KEY=          # Jev via OpenRouter (~typesafe/jev-latest)
ANTHROPIC_API_KEY=           # Claude fallback for decisions (uncalibrated: gates add +0.1)
BRAIN_FALLBACK_MODEL=claude-opus-5

# Lead alerts: every intake and study application lands on your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEADS_WEBHOOK_URL=           # optional: Slack/Zapier/n8n/Sheets webhook

# Booking + payment links shown after intake
NEXT_PUBLIC_BOOKING_URL=     # e.g. https://cal.com/<you>/intro
NEXT_PUBLIC_PAYSTACK_URL=    # NGN payment page
NEXT_PUBLIC_STRIPE_URL=      # USD payment link

# x402 v2: agents pay per call in USDC on Celo. Paid routes answer 503 until X402_PAY_TO is set.
X402_PAY_TO=                 # receiving wallet (0x + 40 hex). Use a fresh wallet, not a personal one.
X402_NETWORK=celo            # celo (eip155:42220) or celo-sepolia (eip155:11142220)
X402_API_KEY=                # from x402.celo.org; the hosted facilitator needs it to settle
X402_FACILITATOR_URL=        # optional override; defaults to Celo's hosted facilitator for the network

# ERC-8004 identity served at /agent.json (registration-v1)
ERC8004_AGENT_ID=
